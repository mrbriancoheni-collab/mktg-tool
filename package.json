{
  "name": "adcanvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered visual canvas for planning, building, and analyzing ad campaigns end to end.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "icons": "tsx scripts/gen-brand-icons.ts",
    "smoke": "tsx scripts/smoke.ts",
    "predev": "tsx scripts/gen-brand-icons.ts",
    "prebuild": "tsx scripts/gen-brand-icons.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@electric-sql/pglite": "^0.5.15",
    "@sentry/node": "^10.78.0",
    "@xyflow/react": "^12.12.1",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "lucide-react": "^1.68.0",
    "marked": "^15.0.12",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0",
    "stripe": "^23.1.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}

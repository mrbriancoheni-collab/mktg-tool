{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "adcanvas/toc",
  "title": "Table of contents",
  "category": "theme",
  "icon": "list-view",
  "description": "\"On this page\" links to the post's sections, built from its headings. Hidden when there are fewer sections than the minimum.",
  "textdomain": "adcanvas",
  "attributes": {
    "minHeadings": { "type": "number", "default": 3 },
    "includeH3": { "type": "boolean", "default": false }
  },
  "usesContext": ["postId"],
  "supports": { "html": false, "spacing": { "margin": true } },
  "editorScript": "adcanvas-editor",
  "render": "file:./render.php"
}

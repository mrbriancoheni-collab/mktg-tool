# Copy to .env for local development (never commit .env).
# Everything is optional locally: without DATABASE_URL an embedded Postgres
# is used, without ANTHROPIC_API_KEY AI runs in demo mode, and without
# STRIPE_SECRET_KEY billing is off (unlimited plan).

# ── Core ──
APP_URL=http://localhost:5173            # public URL; used in emails, OAuth redirects, report links
MARKETING_URL=                           # marketing/blog site when the app runs on app.yourdomain.com, e.g. https://yourdomain.com
PORT=8787
DATABASE_URL=                            # postgres://user:pass@host:5432/db  (required in production)
ENCRYPTION_KEY=                          # 32 bytes, hex or base64: openssl rand -hex 32  (required in production; never rotate casually)
SESSION_SECRET=                          # 32 bytes, hex or base64: openssl rand -hex 32  (required in production)
TRUST_PROXY=true                         # behind a load balancer (Render, Fly, Railway): keep true
RUN_SCHEDULER=true                       # set false on all but one instance if you scale out

# ── AI ──
ANTHROPIC_API_KEY=
ADCANVAS_MODEL=claude-opus-5-5

# ── Billing (Stripe) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                   # from the webhook endpoint: {APP_URL}/api/billing/webhook
STRIPE_PRICE_PRO=                        # price_... for the $49/mo plan
STRIPE_PRICE_TEAM=                       # price_... for the $149/mo plan
BILLING_ENABLED=true                     # set false to keep Stripe configured but grant unlimited usage

# ── Email (Resend) ──
RESEND_API_KEY=                          # without it, emails (invites, resets) are printed to the server log
EMAIL_FROM=AdCanvas <no-reply@example.com>

# ── Monitoring ──
SENTRY_DSN=

# ── Google (Ads + GA4) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=                  # e.g. v22 — check developers.google.com/google-ads/api/docs/release-notes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=            # optional default manager (MCC) account ID

# ── Meta ──
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=                      # e.g. v24.0 — check developers.facebook.com/docs/graph-api/changelog
META_CONVERSION_ACTIONS=purchase,lead,complete_registration

# ── LinkedIn ──
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=                    # YYYYMM — learn.microsoft.com/linkedin/marketing/versioning

# ── TikTok ──
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ── Revenue sources ──
SHOPIFY_API_VERSION=                     # YYYY-MM — shopify.dev/docs/api/usage/versioning
SALESFORCE_API_VERSION=                  # e.g. v62.0

# ── Sign-in & analytics ──
GOOGLE_LOGIN=true                        # "Sign in with Google" (uses GOOGLE_CLIENT_ID/SECRET)
ADMIN_EMAILS=                            # comma-separated; can open /admin product analytics
POSTHOG_API_KEY=                         # optional: forward product events to PostHog
POSTHOG_HOST=https://us.i.posthog.com

# ── Local testing only ──
ALLOW_PRIVATE_WEBHOOKS=false             # true lets webhooks target localhost/private IPs (never in production)

# ── Data retention (days) ──
AUDIT_RETENTION_DAYS=365
USAGE_RETENTION_DAYS=730
